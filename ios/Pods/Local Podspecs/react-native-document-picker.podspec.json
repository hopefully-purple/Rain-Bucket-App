{
  "name": "react-native-document-picker",
  "version": "12.0.1",
  "summary": "A react native interface to access documents from dropbox, google drive, iCloud...",
  "homepage": "https://github.com/react-native-documents/document-picker#readme",
  "license": "MIT",
  "authors": "Vojtech Novak (hello@react-native-training.eu)",
  "platforms": {
    "ios": "14.0"
  },
  "source": {
    "git": "https://github.com/react-native-documents/sponsors-only.git",
    "tag": "v12.0.1"
  },
  "source_files": [
    "ios/**/*.{h,m,mm,swift}"
  ],
  "swift_versions": "6.0",
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "HEADER_SEARCH_PATHS": "\"$(PODS_ROOT)/Headers/Private/Yoga\"",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "OTHER_CPLUSPLUSFLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED=1 ",
    "OTHER_SWIFT_FLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED"
  },
  "compiler_flags": "-DRCT_NEW_ARCH_ENABLED=1",
  "dependencies": {
    "React-Core": [],
    "React-RCTFabric": [],
    "ReactCodegen": [],
    "RCTRequired": [],
    "RCTTypeSafety": [],
    "ReactCommon/turbomodule/bridging": [],
    "ReactCommon/turbomodule/core": [],
    "React-NativeModulesApple": [],
    "Yoga": [],
    "React-Fabric": [],
    "React-graphics": [],
    "React-utils": [],
    "React-featureflags": [],
    "React-debug": [],
    "React-ImageManager": [],
    "React-rendererdebug": [],
    "React-jsi": [],
    "React-renderercss": [],
    "hermes-engine": [],
    "ReactNativeDependencies": [],
    "React-Core-prebuilt": []
  },
  "swift_version": "6.0"
}
